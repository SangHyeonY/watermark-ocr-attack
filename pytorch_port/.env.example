# Timely GPT 중계 서버 API 키 설정 템플릿
#
# 사용법:
# 1. 이 파일을 복사해서 같은 폴더에 ".env"라는 이름으로 저장하세요.
#    (파일명 앞에 점(.)이 있어야 합니다 - ".env", ".env.example"이 아닙니다)
# 2. 아래 TIMELY_API_KEY= 뒤에 실제 발급받은 키 값을 붙여넣으세요.
# 3. .env 파일은 .gitignore에 등록되어 있어 git에 올라가지 않습니다.
#    (이 .env.example 템플릿 파일만 git에 포함됩니다 - 실제 키 없음)
#
# 주의: .env 파일은 절대 다른 사람과 공유하거나 채팅에 붙여넣지 마세요.

TIMELY_API_KEY=여기에_실제_키_값을_붙여넣으세요

# Timely 중계 서버 주소 (OpenAI 호환 방식)
TIMELY_BASE_URL=https://hello.timelygpt.co.kr/api/v2/chat/bridge/openai

# 사용할 모델 이름 (OpenCode 설정의 "timely/" 접두어는 제외하고 입력)
# 이미지 입력(vision)이 필요한 실험이므로 Claude Sonnet 계열을 기본값으로 둠.
TIMELY_MODEL=anthropic/claude-sonnet-5
